    {
      "name": "get_company",
      "description": "A LinkedIn company's details by its universal name (the slug in linkedin.com/company/<name>): name, description, website, employee count and headquarters.",
      "kind": "read",
      "spends": false,
      "idempotent": true,
      "requires_confirmation": false,
      "params": {
        "universal_name": {
          "type": "string",
          "required": true,
          "description": "the slug after /company/ in its address, e.g. microsoft",
          "example": "microsoft"
        }
      },
      "steps": [
        {
          "id": "page",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/company/{{params.universal_name | urlencode}}/",
            "headers": {
              "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
            }
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "html",
            "paths": []
          },
          "extract": {
            "items": {
              "from": "body",
              "type": "regex",
              "expr": "<script type=\"application/ld\\+json\">\\s*([\\s\\S]*?)\\s*</script>",
              "parse": "json",
              "then": "$['@graph'][?(@['@type'] == 'Organization')]"
            }
          }
        }
      ],
      "output": {
        "from": "steps.page.items",
        "fields": {
          "name": "$.name",
          "linkedin_url": "$.url",
          "description": "$.description",
          "website": "$.sameAs",
          "employees": "$.numberOfEmployees.value",
          "city": "$.address.addressLocality",
          "region": "$.address.addressRegion",
          "country": "$.address.addressCountry"
        }
      },
      "examples": [
        {
          "params": {
            "universal_name": "microsoft"
          },
          "min_items": 1
        }
      ],
      "tier": "impersonate"
    },
    {
      "name": "get_profile",
      "description": "A LinkedIn member's public profile by vanity name (the slug in linkedin.com/in/<name>): name, roles, current organisations, location, about and follower count.",
      "kind": "read",
      "spends": false,
      "idempotent": true,
      "requires_confirmation": false,
      "params": {
        "vanity_name": {
          "type": "string",
          "required": true,
          "description": "the slug after /in/ in their profile address, e.g. williamhgates",
          "example": "williamhgates"
        }
      },
      "steps": [
        {
          "id": "page",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/in/{{params.vanity_name | urlencode}}/",
            "headers": {
              "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
            }
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "html",
            "paths": []
          },
          "extract": {
            "items": {
              "from": "body",
              "type": "regex",
              "expr": "<script type=\"application/ld\\+json\">\\s*([\\s\\S]*?)\\s*</script>",
              "parse": "json",
              "then": "$['@graph'][?(@['@type'] == 'Person')]"
            }
          }
        }
      ],
      "output": {
        "from": "steps.page.items",
        "fields": {
          "name": "$.name",
          "linkedin_url": "$.url",
          "job_titles": "$.jobTitle",
          "works_for": "$.worksFor[*].name",
          "location": "$.address.addressLocality",
          "about": "$.description",
          "followers": "$.interactionStatistic.userInteractionCount"
        }
      },
      "examples": [
        {
          "params": {
            "vanity_name": "williamhgates"
          },
          "min_items": 1
        }
      ],
      "tier": "browser"
    },
    {
      "name": "get_profile_education",
      "description": "A LinkedIn member's education by vanity name: one row per school, with its LinkedIn page and years.",
      "kind": "read",
      "spends": false,
      "idempotent": true,
      "requires_confirmation": false,
      "params": {
        "vanity_name": {
          "type": "string",
          "required": true,
          "description": "the slug after /in/ in their profile address, e.g. williamhgates",
          "example": "williamhgates"
        }
      },
      "steps": [
        {
          "id": "page",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/in/{{params.vanity_name | urlencode}}/",
            "headers": {
              "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
            }
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "html",
            "paths": []
          },
          "extract": {
            "items": {
              "from": "body",
              "type": "regex",
              "expr": "<script type=\"application/ld\\+json\">\\s*([\\s\\S]*?)\\s*</script>",
              "parse": "json",
              "then": "$['@graph'][?(@['@type'] == 'Person')].alumniOf[?(@['@type'] == 'EducationalOrganization')]"
            }
          }
        }
      ],
      "output": {
        "from": "steps.page.items",
        "fields": {
          "school": "$.name",
          "school_url": "$.url",
          "start_year": "$.member.startDate",
          "end_year": "$.member.endDate"
        }
      },
      "examples": [
        {
          "params": {
            "vanity_name": "williamhgates"
          },
          "min_items": 1
        }
      ],
      "tier": "browser"
    }
  ]
}