    {
      "name": "follow_company",
      "description": "Follows a LinkedIn company page so its posts show up in the user's feed. Returns no data; success means the user now follows the company.",
      "kind": "write",
      "spends": false,
      "idempotent": false,
      "requires_confirmation": true,
      "params": {
        "company_slug": {
          "type": "string",
          "required": true,
          "description": "The company's URL slug from its LinkedIn page address, e.g. \"anthropicresearch\" from linkedin.com/company/anthropicresearch.",
          "example": "anthropicresearch"
        }
      },
      "steps": [
        {
          "id": "company",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/company/{{params.company_slug | urlencode}}/",
            "headers": {
              "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
            }
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "html",
            "paths": []
          },
          "extract": {
            "value": {
              "from": "body",
              "type": "regex",
              "expr": "\"clientPageInstance\">\\\n  ([^\"'<>&\\s]+)"
            },
            "company_id": {
              "from": "body",
              "type": "regex",
              "expr": "\\A[\\s\\S]*?urn:li:organization:(\\d+)"
            }
          }
        },
        {
          "id": "urn_li_fsd_followingstate_urn_",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/voyager/api/feed/dash/followingStates/urn:li:fsd_followingState:urn:li:fsd_company:{{steps.company.company_id}}",
            "headers": {
              "origin": "{{base_url}}",
              "referer": "{{base_url}}/company/{{params.company_slug}}/",
              "accept": "application/vnd.linkedin.normalized+json+2.1",
              "content-type": "application/json; charset=UTF-8",
              "csrf-token": "{{session.cookies.JSESSIONID | strip_quotes}}",
              "x-li-lang": "en_US",
              "x-li-page-instance": "{{steps.company.value}}",
              "x-li-pem-metadata": "Voyager - Organization - Member=organization-follow",
              "x-restli-protocol-version": "2.0.0"
            },
            "body": {
              "patch": {
                "$set": {
                  "following": true
                }
              }
            }
          },
          "expect": {
            "status": [
              200,
              201,
              202,
              204
            ],
            "content_type": "any",
            "paths": []
          },
          "extract": {}
        }
      ],
      "output": {
        "from": null
      },
      "examples": [],
      "tier": "browser",
      "auth_provider": "linkedin"
