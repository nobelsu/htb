    {
      "name": "send_connection_request",
      "description": "Sends a LinkedIn connection request to the member identified by their profile vanity name. This changes state on the user's account by creating a pending invitation, so the user must explicitly approve it before the tool is called.",
      "kind": "write",
      "spends": false,
      "idempotent": false,
      "requires_confirmation": true,
      "params": {
        "vanity_name": {
          "type": "string",
          "required": true,
          "description": "The target member's LinkedIn vanity name, which is the slug after /in/ in their profile URL (e.g. 'jane-doe-123')."
        }
      },
      "steps": [
        {
          "id": "identity_dash_profiles",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/voyager/api/graphql",
