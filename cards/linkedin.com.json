            },
            "headers": {
              "accept": "application/vnd.linkedin.normalized+json+2.1",
              "csrf-token": "{{session.cookies.JSESSIONID | strip_quotes}}",
              "x-li-lang": "en_US",
              "x-restli-protocol-version": "2.0.0"
            },
            "body": null
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "any",
            "paths": [
              "$.data.data.identityDashProfilesByMemberIdentity['*elements']"
            ]
          },
          "extract": {
            "elements": {
              "from": "body",
              "type": "jsonpath",
              "expr": "$.data.data.identityDashProfilesByMemberIdentity['*elements'][0]"
            }
