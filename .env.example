# Copy to .env and fill in. Never commit .env.

# Bearer key MCP clients must send: Authorization: Bearer <key>. This key is user "default"; everyone else gets
# their own key (sign-up page below, or: uv run python -m runtime.keys add NAME --email EMAIL)
GATEWAY_API_KEY=change-me
# Invite code for the sign-up page at <PUBLIC_BASE_URL>/signup. Empty = sign-up is off
SIGNUP_CODE=

# Secret used to sign confirmation ids (HMAC-SHA256). Any long random string.
CONFIRMATION_SECRET=change-me-too

# SQLite file for the action_maps registry
REGISTRY_DB=./runtime.db

# Gateway bind address
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# Residential proxy for signed-in traffic and the login browser (empty = everything goes direct). Copy your
# provider's "sticky session" URL and put {session} where its session id goes; each sign-in then keeps one home IP.
# Shape (check your provider's docs): http://USER-session-{session}:PASS@gateway.provider.example:7000
# The login browser needs an http:// proxy URL. Sites on this machine (localhost) always go direct.
PROXY_URL=

# Optional, local dev only: session cookies per domain and auth provider, as JSON.
# {"linkedin.com": {"linkedin": {"li_at": "...", "JSESSIONID": "\"ajax:123\""}}}
DEV_SESSION_COOKIES=

# Healing
# What heal jobs use to re-map a broken site:
#   mapper = WeiWei's mapper: re-records the broken actions from their recordings in CAPTURES_DIR/<domain>/
#   module:Class = anything else, e.g. the fixture shop's stand-in tests.fixture_site.remapper:FixtureRemapper
REMAPPER=mapper
# Where the mapper's recordings live (one folder per site, as written by `python -m mapper capture`)
CAPTURES_DIR=./captures
# Seconds a PAGE_CHANGED result tells the agent to wait before retrying
HEAL_RETRY_AFTER_S=30
# Scheduled health checks for no-login sites. 0 = off (keep it off for the demo site during judging)
HEALTH_CHECK_INTERVAL_S=0
# Comma-separated domains never health-checked
HEALTH_CHECK_DISABLED_DOMAINS=

# Login and the browser tier
# Key that encrypts stored session cookies. Generate: uv run python -m runtime.session_store
SESSION_KEY=
# Public URL of this gateway, used in sign-in links (https when hosted)
PUBLIC_BASE_URL=http://127.0.0.1:8765
# Server-side browser profiles for the browser tier (one per user/site/provider). Persistent storage.
PROFILES_DIR=./profiles
# chrome = installed Google Chrome (on a server: uv run playwright install chrome); chromium = Playwright's
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=1
# Close a profile's browser after this many idle seconds
BROWSER_IDLE_S=600
# How long a login link stays valid
CONNECT_TIMEOUT_S=600
# Re-run session_check for connected sessions every N seconds (0 = off)
KEEPALIVE_INTERVAL_S=900

# "Log in here": Neko login browsers in Docker, streamed over WebRTC (docker pull ghcr.io/m1k1o/neko/chromium:latest)
NEKO_ENABLED=1
NEKO_IMAGE=ghcr.io/m1k1o/neko/chromium:latest
# IP users' browsers reach for the video: the server's public IP when hosted; "auto" = this machine's network
# IP (local development; never 127.0.0.1, which Firefox refuses for WebRTC)
NEKO_PUBLIC_IP=auto
# Ports published for WebRTC, one per login in progress, on UDP and TCP (open both in the firewall when hosted)
NEKO_UDP_PORTS=52000-52099
# Optional STUN/TURN servers as a JSON list, for users behind strict networks
NEKO_ICE_SERVERS=
# The login browser's languages (its Accept-Language); saved with each sign-in and sent on its later requests
NEKO_ACCEPT_LANGUAGES=en-US,en
