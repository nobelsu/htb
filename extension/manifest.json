{
  "manifest_version": 3,
  "name": "HTB Connect",
  "version": "0.1.0",
  "description": "Connect a site you're logged in to, so your AI agent can use it. Your password is never shared.",
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "action": {
    "default_title": "HTB Connect"
  }
}
