    {
      "name": "search_products",
      "description": "Search the shop's products by keyword. Returns id, sku, name and price; 5 per page.",
      "kind": "read",
      "spends": false,
      "idempotent": true,
      "requires_confirmation": false,
      "params": {
        "query": {
          "type": "string",
          "required": true,
          "description": "search text",
          "example": "lamp"
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "1-based page number"
        }
      },
      "steps": [
        {
          "id": "search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products",
            "query": {
              "q": "{{params.query}}",
              "start": "{{params.page | offset:5}}",
              "count": "5"
            },
            "headers": {},
            "body": null
          },
          "expect": {
            "status": [
              200
            ],
            "content_type": "json",
            "paths": [
              "$.results"
            ]
          },
          "extract": {
            "items": {
              "from": "body",
              "type": "jsonpath",
              "expr": "$.results[*]"
            },
            "total": {
              "from": "body",
              "type": "jsonpath",
              "expr": "$.total"
            }
          }
        }
      ],
      "output": {
        "from": "steps.search.items",
        "fields": {
          "id": "$.id",
          "sku": "$.sku",
          "name": "$.name",
          "price": "$.price",
          "colour": "$.colour"
        },
        "limit": 5,
        "next_params": {
          "param": "page",
          "increment": 1,
          "page_size": 5,
          "until": "steps.search.total"
        }
      },
      "verify": null,
      "examples": [
        {
          "params": {
            "query": "lamp"
          },
          "min_items": 1
        }
      ]
    },
